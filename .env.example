# LES NOIRES Configuration

# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Database (optionnel - local first)
DB_TYPE=sqlite
DB_PATH=./data/les-noires.db

# Mesh Network
MESH_PORT=5000
MESH_PROTOCOL=direct
MAX_PEERS=50
PEER_DISCOVERY_INTERVAL=30000

# Encryption
CRYPTO_ALGORITHM=ed25519
MESSAGE_ENCRYPTION=aes-256-gcm

# Africa Region
AFRICA_REGION=true
PHONE_PREFIX_VALIDATION=true

# Security
SECRET_KEY=your-secret-key-here
JWT_EXPIRY=7d
SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/les-noires.log

# Feature Flags
ENABLE_MESH_RELAY=true
ENABLE_LOCAL_STORAGE=true
ENABLE_PEER_DISCOVERY=true
